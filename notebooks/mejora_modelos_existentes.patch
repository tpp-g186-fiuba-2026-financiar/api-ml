+# El modelo solo da "alza"/"baja" en el ~20% de los casos donde mas se anima (el
+# resto es "neutral"): opinar siempre, con precios que suben mas de lo que bajan,
+# da aciertos que no son del modelo. Ver notebooks/evaluacion_baselines.py.
+ABSTENTION_COVERAGE = 0.20
+
+
+def abstention_band(
+    pred_log_returns: np.ndarray, default: float, coverage: float = ABSTENTION_COVERAGE
+) -> float:
+    """Banda "neutral" calibrada con las predicciones de validacion.
+
+    Es el retorno esperado (en valor absoluto) a partir del cual el modelo esta
+    entre el ``coverage`` de casos mas extremos que vio fuera de muestra. Sin
+    predicciones de validacion devuelve ``default`` (el valor fijo anterior).
+    """
+    if len(pred_log_returns) == 0:
+        return default
+    band = float(np.quantile(np.abs(np.expm1(np.asarray(pred_log_returns))), 1.0 - coverage))
+    return band if band > 0 else default
+
