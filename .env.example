API_PORT=8000
MODEL_PATH=models/model.pkl
DATABASE_URL=postgres://postgres:password@db_data_collector_postgres:5432/postgres

# --- Modelo LSTM de tendencia ---
LSTM_MODEL_PATH=models/lstm.pt
# Fuente de datos historicos: "yahoo" (directo) o "collector" (data-colector).
DATA_SOURCE=yahoo
# URL del data-colector (solo si DATA_SOURCE=collector).
# DATA_COLLECTOR_URL=http://data_collector:8080
# Sufijo de mercado para Yahoo Finance (BYMA = .BA).
MARKET_SUFFIX=.BA
# Ruedas de historia a usar para entrenar / predecir.
HISTORY_DAYS=750
