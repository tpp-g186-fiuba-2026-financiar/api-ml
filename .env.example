API_PORT=8000
MODEL_PATH=models/model.pkl
DATABASE_URL=postgres://postgres:password@db_data_collector_postgres:5432/postgres

# --- Modelo LSTM de tendencia ---
LSTM_MODEL_PATH=models/lstm.pt
# Fuente de datos historicos: "yahoo" (directo) o "collector" (data-colector).
DATA_SOURCE=yahoo
# URL del data-colector (tickers, tasas, series macro y, si DATA_SOURCE=collector,
# historicos). Default: el local de docker. En el deploy de Render hay que setearla.
# DATA_COLLECTOR_URL=http://service_data_collector:3000
# Sufijo de mercado para Yahoo Finance (BYMA = .BA).
MARKET_SUFFIX=.BA
# Ruedas de historia a usar para entrenar / predecir.
HISTORY_DAYS=750

# Modelos de tendencia que registra la API: local (artefactos de models/),
# modal (solo los de Modal, sin cargar artefactos) o ambos (default).
# TREND_MODELS=ambos

# --- Modelos alternativos deployados en Modal (repo `models`) ---
# Usar la URL de "modal deploy" (estable), no la de "modal serve" (efimera).
# Las de abajo ya son el default; una URL vacia (MODAL_SVM_URL=) saca ese modelo.
# MODAL_LSTM_URL=https://matimorales01--lstm-trend-model-main.modal.run
# MODAL_XGBOOST_URL=https://matimorales01--xgboost-trend-model-main.modal.run
# MODAL_TRANSFORMER_URL=https://matimorales01--transformer-trend-model-main.modal.run
# MODAL_ARIMA_URL=https://matimorales01--arima-model-main.modal.run
# MODAL_SVM_URL=https://matimorales01--svm-model-main.modal.run
# MODAL_GARCH_URL=https://matimorales01--garch-model-main.modal.run
